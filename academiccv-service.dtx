%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-service}{2024/12/20}{v2.0}{Academic curriculum vitae: service}

\ExplSyntaxOn

\colorlet{serviceframe}{black}

\tcbset{
  service/.code = {
    \serviceTitleColor{serviceframe}
    \pgfkeysalso{basic = {serviceframe}{servicetitle}{#1}}
  },
}

\tl_new:N \l__service_title_tl
\tl_new:N \l__service_date_tl
\clist_new:N \l__service_description_clist
\keys_define:nn { service } {
  title.tl_set:N = \l__service_title_tl,
  title.value_required:n = true,
  date.tl_set:N = \l__service_date_tl,
  date.value_required:n = true,
  description.clist_set:N = \l__service_description_clist,
  description.initial:V = \c_empty_clist,
}

\newBox {service} {
  \printDate {\l__service_date_tl}
  \par
  \clist_if_empty:NF {\l__service_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__service_description_clist} {\par}}
  }
} {Se}

\ExplSyntaxOff

\endinput