%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-award}{2024/12/20}{v2.0}{Academic curriculum vitae: awards}

\ExplSyntaxOn

\colorlet{awardframe}{black}

\tcbset{
  award/.code = {
    \awardTitleColor{awardframe}
    \pgfkeysalso{basic = {awardframe}{awardtitle}{#1}}
  },
}

\tl_new:N \l__award_title_tl
\tl_new:N \l__award_date_tl
\clist_new:N \l__award_description_clist
\keys_define:nn { award } {
  title.tl_set:N = \l__award_title_tl,
  title.value_required:n = true,
  date.tl_set:N = \l__award_date_tl,
  date.value_required:n = true,
  description.clist_set:N = \l__award_description_clist,
  description.initial:V = \c_empty_tl,
}

\newBox {award} {
  \printDate {\l__award_date_tl}
  \par
  \clist_if_empty:NF {\l__award_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__award_description_clist} {\par}}
  }
} {Aw}

\ExplSyntaxOff

\endinput