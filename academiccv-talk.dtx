%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-talk}{2024/12/20}{v2.0}{Academic curriculum vitae: talks}

\ExplSyntaxOn

\colorlet{talkframe}{black}

\tcbset{
  talk/.code = {
    \talkTitleColor{talkframe}
    \pgfkeysalso{basic = {talkframe}{talktitle}{#1}}
  },
}

\tl_new:N \l__talk_title_tl
\tl_new:N \l__talk_where_tl
\tl_new:N \l__talk_date_tl
\keys_define:nn { talk } {
  title.tl_set:N = \l__talk_title_tl,
  title.value_required:n = true,
  where.tl_set:N = \l__talk_where_tl,
  where.value_required:n = true,
  date.tl_set:N = \l__talk_date_tl,
  date.value_required:n = true,
}

\newBox {talk} {
  \printDate {\l__talk_date_tl}
  \par
  \noindent{\l__talk_where_tl.}
} {Ta}

\ExplSyntaxOff

\endinput