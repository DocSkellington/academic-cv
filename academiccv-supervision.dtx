%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-supervision}{2023/08/26}{v1.0}{Academic curriculum vitae: supervision}

\ExplSyntaxOn

\colorlet{supervisionframe}{black}

\tcbset{
  supervision/.code = {
    \supervisionTitleColor{supervisionframe}
    \pgfkeysalso{basic = {supervisionframe}{supervisiontitle}{#1}}
  },
}

\tl_new:N \l__supervision_title_tl
\tl_new:N \l__supervision_institute_tl
\tl_new:N \l__supervision_role_tl
\tl_new:N \l__supervision_date_tl
\clist_new:N \l__supervision_description_clist
\keys_define:nn { supervision } {
  title.tl_set:N = \l__supervision_title_tl,
  title.value_required:n = true,
  institute.tl_set:N = \l__supervision_institute_tl,
  institute.value_required:n = true,
  role.tl_set:N = \l__supervision_role_tl,
  role.initial:V = \c_empty_tl,
  date.tl_set:N = \l__supervision_date_tl,
  date.value_required:n = true,
  description.clist_set:N = \l__supervision_description_clist,
  description.initial:V = \c_empty_clist,
}

\newBox {supervision} {
  \printDate {\l__supervision_date_tl}
  \par
  \printPart{Institute}{\l__supervision_institute_tl.}
  \par
  \tl_if_empty:NF{ \l__supervision_role_tl }
    {\printPart{Role}{\l__supervision_role_tl.}}
  \par
  \clist_if_empty:NF {\l__supervision_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__supervision_description_clist} {\par}}
  }
} {Su}

\ExplSyntaxOff

\endinput