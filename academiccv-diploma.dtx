%<*driver>
\ProvidesFile{\jobname.dtx}
%</driver>
%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-diploma}{2024/12/30}{v2.0}{Academic curriculum vitae: diplomas}

\ExplSyntaxOn

\colorlet{diplomaframe}{black}

\tcbset{
  diploma/.code = {
    \diplomaTitleColor{diplomaframe}
    \pgfkeysalso{basic = {diplomaframe}{diplomatitle}{#1}}
  },
}

\tl_new:N \l__diploma_title_tl
\tl_new:N \l__diploma_institute_tl
\tl_new:N \l__diploma_where_tl
\tl_new:N \l__diploma_date_tl
\clist_new:N \l__diploma_description_clist
\tl_new:N \l__diploma_honor_tl
\tl_new:N \l__diploma_thesisTitle_tl
\keys_define:nn { diploma } {
  title.tl_set:N = \l__diploma_title_tl,
  title.value_required:n = true,
  institute.tl_set:N = \l__diploma_institute_tl,
  institute.value_required:n = true,
  where.tl_set:N = \l__diploma_where_tl,
  where.value_required:n = true,
  date.tl_set:N = \l__diploma_date_tl,
  date.value_required:n = true,
  description.clist_set:N = \l__diploma_description_clist,
  description.initial:V = \c_empty_clist,
  honor.tl_set:N = \l__diploma_honor_tl,
  honor.initial:V = \c_empty_tl,
  thesis~title.tl_set:N = \l__diploma_thesisTitle_tl,
  thesis~title.initial:V = \c_empty_tl,
}

\newBox {diploma} {
  \printDate {\l__diploma_date_tl}
  \par
  \printPart{Institute}{\l__diploma_institute_tl,~\l__diploma_where_tl.}
  \par
  \tl_if_empty:NF{ \l__diploma_honor_tl }
    {\printPart{Honor}{\l__diploma_honor_tl.}}
  \par
  \tl_if_empty:NF{ \l__diploma_thesisTitle_tl }
    {\printPart{Dissertation~title}{\l__diploma_thesisTitle_tl.}}
  \par
  \clist_if_empty:NF {\l__diploma_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__diploma_description_clist} {\par}}
  }
} {Di}

\ExplSyntaxOff

\endinput