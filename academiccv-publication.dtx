%<*driver>
\ProvidesFile{\jobname.dtx}
%</driver>
%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-publication}{2024/12/20}{v2.0}{Academic curriculum vitae: publications}

\ExplSyntaxOn

\colorlet{publicationframe}{black}

\tcbset{
  publication/.code = {
    \publicationTitleColor{publicationframe}
    \pgfkeysalso{basic = {publicationframe}{publicationtitle}{#1}}
  },
}

\tl_new:N \l__publication_ref_tl
\tl_new:N \l__publication_title_tl
\tl_new:N \l__publication_authors_tl
\tl_new:N \l__publication_year_tl
\tl_new:N \l__publication_conference_tl
\tl_new:N \l__publication_core_tl
\tl_new:N \l__publication_pages_tl
\tl_new:N \l__publication_doi_tl
\tl_new:N \l__publication_arxiv_tl
\tl_new:N \l__publication_award_tl
\clist_new:N \l__publication_description_clist

\keys_define:nn { publication } {
  title.tl_set:N = \l__publication_title_tl,
  title.value_required:n = true,
  reference.tl_set:N = \l__publication_ref_tl,
  reference.initial:V = \c_empty_tl,
  authors.tl_set:N = \l__publication_authors_tl,
  authors.value_required:n = true,
  year.tl_set:N = \l__publication_year_tl,
  year.value_required:n = true,
  conference.tl_set:N = \l__publication_conference_tl,
  conference.value_required:n = true,
  core.tl_set:N = \l__publication_core_tl,
  core.initial:V = \c_empty_tl,
  pages.tl_set:N = \l__publication_pages_tl,
  pages.initial:V = \c_empty_tl,
  doi.tl_set:N = \l__publication_doi_tl,
  doi.initial:V = \c_empty_tl,
  arxiv.tl_set:N = \l__publication_arxiv_tl,
  arxiv.initial:V = \c_empty_tl,
  award.tl_set:N = \l__publication_award_tl,
  award.initial:V = \c_empty_tl,
  description.clist_set:N = \l__publication_description_clist,
  description.initial:V = \c_empty_clist,
}

\newBox [
  title={
    \bool_if:NT {\l__publication_numbered_bool} {\thetcbcounter{}:~}
    \tl_if_empty:NF {\l__publication_ref_tl} {[\l__publication_ref_tl]}
    \l__publication_title_tl
  }
] {publication} {
  \printPart{Authors}{\l__publication_authors_tl.}
  \par
  \printPart{Year}{\l__publication_year_tl.}
  \par
  \printPart{Conference}{\l__publication_conference_tl}
  \tl_if_empty:NF {\l__publication_core_tl} {~(CORE~ranking:~\l__publication_core_tl)}.
  \par
  \tl_if_empty:NF {\l__publication_pages_tl} {
    \printPart{Pages}{\l__publication_pages_tl.}
  }
  \par
  \tl_if_empty:NF {\l__publication_doi_tl} {
    \printPart{DOI}{\l__publication_doi_tl.}
  }
  \par
  \tl_if_empty:NF {\l__publication_arxiv_tl} {
    \printPart{arXiv}{\l__publication_arxiv_tl.}
  }
  \par
  \tl_if_empty:NF {\l__publication_award_tl} {
    \printPart{Award}{\l__publication_award_tl.}
  }
  \par
  \clist_if_empty:NF {\l__publication_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__publication_description_clist} {\par}}
  }
} {Pu}

\ExplSyntaxOff

\endinput