%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-item}{2024/12/20}{v2.0}{Academic curriculum vitae: generic items}

\ExplSyntaxOn

\colorlet{basic}{black}

\tcbset {
  basic/.style~n~args = {3}{
    % TikZ
    enhanced,
    % Padding
    left = 0pt,
    right = 0pt,
    top = 3pt,
    bottom = 3pt,
    % Space before and after
    before~skip~balanced = 0.5\baselineskip plus 5pt,
    after~skip~balanced = 0.5\baselineskip plus 5pt,
    % Border
    arc = 0pt,
    boxrule = 0pt,
    leftrule = 2pt,
    rightrule = 0pt,
    % Colors
    colback = white,
    % title,
    title = {#3},
    attach~title~to~upper = {\setlength{\parindent}{10pt}},
    colframe = #1,
    fonttitle = {\color{#2}\bfseries\large},
    after~title = {\par},
    %
    breakable,
  },
}

% \begin{macro}
%    \begin{macrocode}
\NewDocumentCommand{\provideCounter} { m } {
  \ifcsname c@#1\endcsname
    \expandafter{}
  \else
    \expandafter{\newcounter{#1}}
  \fi
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{printPart,printDate,printDateRange}
%    \begin{macrocode}
\NewDocumentCommand{ \printPart }{ m +m }{
  \noindent
  \textbf{#1}:~#2
}
\NewDocumentCommand{ \printDate }{ m }{
  \noindent
  #1
}
\NewDocumentCommand{ \printDateRange }{ m m }{
  \noindent
  #1 ~ \textendash{} ~ #2
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{cvitem}
%    \begin{macrocode}
\NewDocumentCommand{\cvitem}{ O{basic} O{basic} m +m }{
  \begin{tcolorbox}[
    basic = {#1}{#2},
    title = {#3}
  ]
    #4
  \end{tcolorbox}
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{newBox}
%    \begin{macrocode}
\NewDocumentCommand{\l__declareCommand} { m +m m } {
  \exp_args:Nc \ProvideDocumentCommand {#1TitleColor} { m } {
    \colorlet{#1title}{basic!30!##1}
  }

  \exp_args:Nc \DeclareDocumentCommand {#1}
  { O{} m } {
    \group_begin:
      \keys_set:nn { #1 } { ##2 }
      \bool_if:cTF {l__#1_numbered_bool} {
        \begin{l__#1_numbered_env} {##1} {\use:c {l__#1_#3}}
          #2
        \end{l__#1_numbered_env}
      } {
        \begin{l__#1_env} {##1} {\use:c {l__#1_#3}}
          #2
        \end{l__#1_env}
      }
    \group_end:
  }
}
\NewDocumentCommand{\newBox}{ O{} m +m O{title_tl} m }{
  \provideCounter{#2}
  \bool_new:c {l__#2_numbered_bool}
  \exp_args:Nc \DeclareDocumentCommand {#2NumberingEnable} {} {\bool_set_true:c {l__#2_numbered_bool}}
  \exp_args:Nc \DeclareDocumentCommand {#2NumberingDisable} {} {\bool_set_false:c {l__#2_numbered_bool}}

  \exp_args:Nc \DeclareDocumentCommand {#2CounterTitle} {} {#5}
  \exp_args:Nc \DeclareDocumentCommand {#2CounterFormat} {} {\arabic}

  \DeclareTColorBox{l__#2_env}{ m m }{
    #2 = {##2},
    ##1,
    #1,
  }
  \DeclareTColorBox[
    use~counter = #2,
    number~freestyle = {\use:c {#2CounterTitle} \use:c{#2CounterFormat}{\tcbcounter}}
  ]{l__#2_numbered_env}{ m m }{
    #2 = {##2},
    title = {\thetcbcounter{}:~##2},
    ##1,
    #1,
  }
  \l__declareCommand {#2} {#3} {#4}
}
%    \end{macrocode}
% \end{macro}

\ExplSyntaxOff

