%<*driver>
\ProvidesFile{\jobname.dtx}
%</driver>
%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-item}{2024/12/15}{v2.0}{Academic curriculum vitae: generic items}

\ExplSyntaxOn

\colorlet{basic}{black}

\tcbset {
  basic/.style~n~args = {3}{
    % TikZ
    enhanced,
    % Padding
    left = 0pt,
    right = 0pt,
    top = 3pt,
    bottom = 3pt,
    % Space before and after
    before~skip~balanced = 0.5\baselineskip plus 5pt,
    after~skip~balanced = 0.5\baselineskip plus 5pt,
    % Border
    arc = 0pt,
    boxrule = 0pt,
    leftrule = 2pt,
    rightrule = 0pt,
    % Colors
    colback = white,
    % title,
    title = {#3},
    attach~title~to~upper = {\setlength{\parindent}{10pt}},
    colframe = #1,
    fonttitle = {\color{#2}\bfseries\large},
    after~title = {\par},
    %
    breakable,
  },
}

% \begin{macro}
%    \begin{macrocode}
\NewDocumentCommand{\provideCounter} { m } {
  \ifcsname c@#1\endcsname
    \expandafter{}
  \else
    \expandafter{\newcounter{#1}}
  \fi
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{printPart,printDateRange}
%    \begin{macrocode}
\NewDocumentCommand{ \printPart }{ m +m }{
  \noindent
  \textbf{#1}:~#2
}
\NewDocumentCommand{ \printDateRange }{ m m }{
  \noindent
  #1 ~ \textendash{} ~ #2
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{cvitem}
%    \begin{macrocode}
\NewDocumentCommand{\cvitem}{ O{basic} O{basic} m +m }{
  \begin{tcolorbox}[
    basic = {#1}{#2},
    title = {#3}
  ]
    #4
  \end{tcolorbox}
}
%    \end{macrocode}
% \end{macro}

% \begin{macro}{newBox}
%    \begin{macrocode}
\NewDocumentCommand{\l__declareCommand} {m +m m } {
  \exp_args:Nc \ProvideDocumentCommand {#1TitleColor} { m } {
    \colorlet{#1title}{basic!30!##1}
  }

  \exp_args:Nc \DeclareDocumentCommand {#1}
  { O{} m } {
    \group_begin:
      \keys_set:nn { #1 } { ##2 }
      \begin{l__#1_env} {##1} {\use:c {l__#1_#3}}
        #2
      \end{l__#1_env}
    \group_end:
  }
}
\NewDocumentCommand{\newBox}{ m +m O{title_tl} }{
  \NewTColorBox{l__#1_env}{ m m }{
    #1 = {##2},
    ##1,
  }
  \l__declareCommand {#1} {#2} {#3}
}
\NewDocumentCommand{\newBoxWithCounter}{ m +m O{title_tl} m }{
  \provideCounter{#1}
  \exp_args:Nc \DeclareDocumentCommand {#1CounterTitle} {} {#4}
  \exp_args:Nc \DeclareDocumentCommand {#1CounterFormat} {} {
    \use:c {#1CounterTitle} \arabic{\tcbcounter}
  }
  \DeclareTColorBox[
    use~counter = #1,
    number~freestyle = {\use:c {#1CounterFormat} }
  ]{l__#1_env}{ m m }{
    #1 = {##2},
    title = {\thetcbcounter{}:~##2},
    ##1,
  }
  \l__declareCommand {#1} {#2} {#3}
}
%    \end{macrocode}
% \end{macro}

\ExplSyntaxOff

