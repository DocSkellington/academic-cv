%<*driver>
\ProvidesFile{\jobname.dtx}
%</driver>
%<package>\NeedsTeXFormat{LaTeX2e}
%<package>\ProvidesExplPackage{academiccv-job}{2024/12/15}{v2.0}{Academic curriculum vitae: jobs}

\ExplSyntaxOn

\colorlet{jobframe}{black}

\tcbset{
  job/.code = {
    \jobTitleColor{jobframe}
    \pgfkeysalso{basic = {jobframe}{jobtitle}{#1}}
  },
}

\tl_new:N \l__job_title_tl
\tl_new:N \l__job_start_tl
\tl_new:N \l__job_end_tl
\tl_new:N \l__job_institute_tl
\tl_new:N \l__job_where_tl
\clist_new:N \l__job_description_clist
\keys_define:nn { job } {
  title.tl_set:N = \l__job_title_tl,
  title.value_required:n = true,
  start.tl_set:N = \l__job_start_tl,
  start.value_required:n = true,
  end.tl_set:N = \l__job_end_tl,
  end.value_required:n = true,
  institute.tl_set:N = \l__job_institute_tl,
  institute.value_required:n = true,
  where.tl_set:N = \l__job_where_tl,
  where.value_required:n = true,
  description.clist_set:N = \l__job_description_clist,
  description.initial:V = \c_empty_clist,
}

\newBoxWithCounter {job} {
  \printDateRange {\l__job_start_tl} {\l__job_end_tl}
  \par
  \printPart{Institute}{\l__job_institute_tl,~\l__job_where_tl.}
  \par
  \clist_if_empty:NF {\l__job_description_clist} {
    \printPart{Description}{\clist_use:Nn {\l__job_description_clist} {\par}}
  }
} {WE} % Work Experience

\ExplSyntaxOff

\endinput